{
  "name": "studymate",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web --output-dir dist",
    "web:preview": "node ../scripts/preview.mjs",
    "test": "cross-env TZ=Asia/Ho_Chi_Minh jest",
    "test:watch": "cross-env TZ=Asia/Ho_Chi_Minh jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check \"src/**/*.{ts,tsx}\"",
    "verify": "npm run lint && npm run format && npm run typecheck && npm test"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**"
    ]
  }
}
